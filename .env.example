# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Payments - Paystack (https://dashboard.paystack.com)
# Get keys from Paystack Dashboard > Settings > API Keys
PAYSTACK_SECRET_KEY=sk_test_xxxxx  # or sk_live_xxxxx for production
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx  # or pk_live_xxxxx for production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx  # or pk_live_xxxxx for production

# Payments - Stripe (optional, for future)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
